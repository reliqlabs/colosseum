# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
Icon?

# --- IDE state ---
.idea/
.vscode/
*.iml
*.sublime-workspace
*.sublime-project

# --- Python (MCP wrappers run via `uv run --script` with inline deps;
#     no venv lives in the tree by default, but guard against accidents) ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Rust (none currently in this repo, but reserved for future tracer-bullet
#     prototypes that might live here) ---
target/
Cargo.lock.bak
# tests/fixtures/m3b/target is a review-TARGET fixture (INTENT + src the
# benchmark reviews), not a Cargo build dir; the global target/ rule above hid
# it and fresh clones failed m3b. Track it. (Real crate build dirs like
# tests/fixtures/r22/adapter/target stay ignored — they sit next to a Cargo.toml.)
!tests/fixtures/m3b/target/
!tests/fixtures/m3b/target/**

# --- Editor / OS scratch ---
*.swp
*.swo
*~
.directory
nul

# --- Local secrets / private overrides ---
.env
.env.*
*.local
*.secret
secrets.toml

# --- Private review narrative (NOT for the public remote) ---
# scratchpad/ holds the 5-round adversarial review artifacts (evaluation
# reports, adjudications, the roadmap source). It lives in the working tree
# but must never be pushed. Everything actionable from it is already in the
# tracked ROADMAP; the raw narrative stays local. See the archive/ note below.
scratchpad/

# --- Build outputs from extraction pipelines that produce artifacts
#     adjacent to source (Aeneas extraction, Lean lake build, etc.) ---
extracted-lean/
.lake/
lake-packages/
build/
*.olean

# --- Runtime / cache directories ---
.crucible/
.colosseum/
# Fixture .colosseum dirs ARE repo content (the global rule above hid them
# from git; fresh clones failed the r22/r28 suites). Run artifacts are
# re-ignored below.
!tests/fixtures/**/.colosseum/
!tests/fixtures/**/.colosseum/**
tests/fixtures/**/.colosseum/verify/
_apalache-out/

# NOTE: the historical archive/ directory is INTENTIONALLY tracked.
# It contains a one-time snapshot of the Claude Code transcripts and
# auto-memory files captured at the crucible→colosseum rename. The live
# copies live under ~/.claude/projects/-Users-mvid/ and continue to evolve;
# the archive in this repo is read-only project history.
#
# If this repo ever goes public: review archive/transcripts/*.jsonl for any
# sensitive content (API endpoints, internal paths, conversational drafts)
# before publishing. The transcripts capture full Claude Code sessions
# verbatim and may contain artifacts not intended for public release.

# R22 fixture run artifacts (regenerated by the suite; never committed)
tests/fixtures/r22/project/.colosseum/verify/
